NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://contextcore:contextcore@localhost:5432/contextcore?schema=public
REDIS_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=your-jwt-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ISSUER=contextcore-api
OPENROUTER_API_KEY=your-openrouter-key
# Optional RAG answer generation. Leave LLM_PROVIDER unset to disable /ask.
# Configure all three values to enable Groq:
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key
# LLM_MODEL=your-groq-chat-model
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:3000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RETRY_COUNT=2
MAX_UPLOAD_SIZE_MB=10
